<Window x:Class="MadaBootstrapV3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MadaBootstrap V3"
        Width="1220"
        Height="820"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020"
        Foreground="White">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#121A2B"/>
        <SolidColorBrush x:Key="CardBrush" Color="#182235"/>
        <SolidColorBrush x:Key="InputBrush" Color="#0D1526"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#2B3C5B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#58A6FF"/>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#22314D"/>
            <Setter Property="BorderBrush" Value="#31486F"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA6C0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MadaBootstrap V3" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Refined Roblox launcher with editor, backup, folders and quality-of-life tools" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Border Background="#122741" Padding="14,8" CornerRadius="12">
                        <TextBlock x:Name="StatusText" Text="Status: idle" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="TimeText" Text="Last action: never" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Rows="1" Columns="4">
            <Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="18" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Client" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ClientSummaryText" Text="Not detected yet" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="18" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Editor" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="JsonSummaryText" Text="JSON editor ready" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="18" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Backups" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BackupSummaryText" Text="No backup action yet" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="18">
                <StackPanel>
                    <TextBlock Text="Place" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PlaceSummaryText" Text="No place launched yet" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="18">
            <TabControl BorderThickness="0" Background="Transparent">
                <TabItem Header="Home">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.3*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Launcher" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="Detected Roblox client path" Style="{StaticResource MutedTextStyle}" Margin="0,14,0,6"/>
                                    <TextBox x:Name="ClientPathBox" Style="{StaticResource InputBoxStyle}"/>

                                    <TextBlock Text="Place ID" Style="{StaticResource MutedTextStyle}" Margin="0,14,0,6"/>
                                    <TextBox x:Name="PlaceIdBox" Style="{StaticResource InputBoxStyle}"/>

                                    <WrapPanel Margin="0,16,0,0">
                                        <Button Style="{StaticResource ActionButtonStyle}" Content="Detect client" Click="DetectClientButton_Click"/>
                                        <Button Style="{StaticResource ActionButtonStyle}" Content="Launch Roblox" Click="LaunchRobloxButton_Click" Background="#1E5B9B"/>
                                        <Button Style="{StaticResource ActionButtonStyle}" Content="Join place" Click="JoinPlaceButton_Click" Background="#227A52"/>
                                        <Button Style="{StaticResource ActionButtonStyle}" Content="Copy client path" Click="CopyClientPathButton_Click"/>
                                        <Button Style="{StaticResource ActionButtonStyle}" Content="Save settings" Click="SaveSettingsButton_Click"/>
                                        <Button Style="{StaticResource ActionButtonStyle}" Content="Write settings now" Click="WriteSettingsNowButton_Click"/>
                                    </WrapPanel>

                                    <TextBlock Text="Options" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                    <CheckBox x:Name="AutoCloseCheck" Content="Close launcher after launch" Foreground="White" Margin="0,12,0,0"/>
                                    <CheckBox x:Name="WriteClientSettingsCheck" Content="Write ClientAppSettings.json when launching" Foreground="White" Margin="0,8,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Quick Actions" FontSize="20" FontWeight="SemiBold"/>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Open Roblox folder" Click="OpenRobloxFolderButton_Click"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Open client folder" Click="OpenClientFolderButton_Click"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Open ClientSettings folder" Click="OpenClientSettingsFolderButton_Click"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Open logs folder" Click="OpenLogsFolderButton_Click"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Load current JSON" Click="LoadCurrentJsonButton_Click"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Format JSON" Click="FormatJsonButton_Click"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Reset JSON" Click="ResetJsonButton_Click"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Backup settings" Click="BackupButton_Click"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Restore backup" Click="RestoreButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Editor">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <WrapPanel>
                            <Button Style="{StaticResource ActionButtonStyle}" Content="Format JSON" Click="FormatJsonButton_Click"/>
                            <Button Style="{StaticResource ActionButtonStyle}" Content="Load current JSON" Click="LoadCurrentJsonButton_Click"/>
                            <Button Style="{StaticResource ActionButtonStyle}" Content="Reset JSON" Click="ResetJsonButton_Click"/>
                            <Button Style="{StaticResource ActionButtonStyle}" Content="Write settings now" Click="WriteSettingsNowButton_Click" Background="#1E5B9B"/>
                        </WrapPanel>
                        <TextBox Grid.Row="2"
                                 x:Name="ClientSettingsBox"
                                 Background="{StaticResource InputBrush}"
                                 Foreground="White"
                                 BorderBrush="{StaticResource BorderBrushColor}"
                                 BorderThickness="1"
                                 Padding="14"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Backup &amp; Paths">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Backups" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BackupPathText" Text="Backup path will appear here" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,14" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Backup settings" Click="BackupButton_Click" Background="#227A52"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Restore backup" Click="RestoreButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Folders" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CurrentPathText" Text="No path loaded" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,14" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Open Roblox folder" Click="OpenRobloxFolderButton_Click"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Open client folder" Click="OpenClientFolderButton_Click"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Open ClientSettings folder" Click="OpenClientSettingsFolderButton_Click"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Open logs folder" Click="OpenLogsFolderButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="6" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="14">
            <TextBlock x:Name="FooterText" Text="Ready." Foreground="#9AA6C0"/>
        </Border>
    </Grid>
</Window>
