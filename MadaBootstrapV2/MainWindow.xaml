<Window x:Class="MadaBootstrapV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MadaBootstrap V2"
        Width="1220"
        Height="820"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020"
        Foreground="White">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#121A2B"/>
        <SolidColorBrush x:Key="CardBrush" Color="#182235"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#58A6FF"/>
        <SolidColorBrush x:Key="Accent2Brush" Color="#7EE787"/>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="MutedStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA6C0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#22314D"/>
            <Setter Property="BorderBrush" Value="#31486F"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#0D1526"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2B3C5B"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Background" Value="#14203A"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MadaBootstrap V2" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Modern Roblox launcher with editor, tools, backups and quick actions" Style="{StaticResource MutedStyle}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Border Background="#122741" Padding="14,8" CornerRadius="12">
                        <TextBlock x:Name="StatusText" Text="Status: idle" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="TimeText" Text="Last action: never" Style="{StaticResource MutedStyle}" Margin="0,8,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}" Padding="18">
                <StackPanel>
                    <TextBlock Text="Client" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="ClientSummaryText" Text="Not detected yet" Style="{StaticResource MutedStyle}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource CardBrush}" Padding="18">
                <StackPanel>
                    <TextBlock Text="Editor" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="JsonSummaryText" Text="JSON editor ready" Style="{StaticResource MutedStyle}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="{StaticResource CardBrush}" Padding="18">
                <StackPanel>
                    <TextBlock Text="Backups" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="BackupSummaryText" Text="No backup action yet" Style="{StaticResource MutedStyle}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Background="{StaticResource CardBrush}" Padding="18">
                <StackPanel>
                    <TextBlock Text="Place" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="PlaceSummaryText" Text="No place launched yet" Style="{StaticResource MutedStyle}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" Padding="18">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="Home">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.1*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource CardBrush}" Padding="18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Launcher" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="Detected Roblox client path" Style="{StaticResource MutedStyle}" Margin="0,14,0,6"/>
                                    <TextBox x:Name="ClientPathBox"/>

                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="Detect client" Click="DetectClientButton_Click"/>
                                        <Button Content="Launch Roblox" Click="LaunchRobloxButton_Click" Background="#1E5B9B"/>
                                        <Button Content="Copy client path" Click="CopyClientPathButton_Click"/>
                                    </WrapPanel>

                                    <TextBlock Text="Place ID" Style="{StaticResource MutedStyle}" Margin="0,8,0,6"/>
                                    <TextBox x:Name="PlaceIdBox"/>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="Join place" Click="JoinPlaceButton_Click" Background="#227A52"/>
                                        <Button Content="Save settings" Click="SaveSettingsButton_Click"/>
                                        <Button Content="Write settings now" Click="WriteSettingsNowButton_Click"/>
                                    </WrapPanel>

                                    <TextBlock Text="Options" Style="{StaticResource CardTitleStyle}" Margin="0,18,0,6"/>
                                    <CheckBox x:Name="AutoCloseCheck" Content="Close launcher after launch"/>
                                    <CheckBox x:Name="WriteClientSettingsCheck" Content="Write ClientAppSettings.json when launching"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource CardBrush}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Quick Actions" Style="{StaticResource CardTitleStyle}"/>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Content="Open Roblox folder" Click="OpenRobloxFolderButton_Click"/>
                                    <Button Content="Open client folder" Click="OpenClientFolderButton_Click"/>
                                    <Button Content="Open ClientSettings folder" Click="OpenClientSettingsFolderButton_Click"/>
                                    <Button Content="Open logs folder" Click="OpenLogsFolderButton_Click"/>
                                    <Button Content="Load current JSON" Click="LoadCurrentJsonButton_Click"/>
                                    <Button Content="Format JSON" Click="FormatJsonButton_Click"/>
                                    <Button Content="Reset JSON" Click="ResetJsonButton_Click"/>
                                    <Button Content="Backup settings" Click="BackupButton_Click"/>
                                    <Button Content="Restore backup" Click="RestoreButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Editor">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <WrapPanel>
                            <Button Content="Format JSON" Click="FormatJsonButton_Click"/>
                            <Button Content="Load current JSON" Click="LoadCurrentJsonButton_Click"/>
                            <Button Content="Reset JSON" Click="ResetJsonButton_Click"/>
                            <Button Content="Write settings now" Click="WriteSettingsNowButton_Click" Background="#1E5B9B"/>
                        </WrapPanel>
                        <TextBox Grid.Row="2"
                                 x:Name="ClientSettingsBox"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 Padding="14"
                                 Height="Auto"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Backup &amp; Paths">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource CardBrush}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Backups" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock x:Name="BackupPathText" Text="Backup path will appear here" Style="{StaticResource MutedStyle}" Margin="0,10,0,14" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button Content="Backup settings" Click="BackupButton_Click" Background="#227A52"/>
                                    <Button Content="Restore backup" Click="RestoreButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource CardBrush}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Folders" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock x:Name="CurrentPathText" Text="No path loaded" Style="{StaticResource MutedStyle}" Margin="0,10,0,14" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button Content="Open Roblox folder" Click="OpenRobloxFolderButton_Click"/>
                                    <Button Content="Open client folder" Click="OpenClientFolderButton_Click"/>
                                    <Button Content="Open ClientSettings folder" Click="OpenClientSettingsFolderButton_Click"/>
                                    <Button Content="Open logs folder" Click="OpenLogsFolderButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="6" Background="{StaticResource PanelBrush}" Padding="14">
            <TextBlock x:Name="FooterText" Text="Ready." Foreground="#9AA6C0"/>
        </Border>
    </Grid>
</Window>
